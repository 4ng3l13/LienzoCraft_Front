<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">
            <View
                android:id="@+id/img_proyecto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E8C6CA"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/accent_lime"
                app:cardCornerRadius="12dp"
                android:layout_margin="16dp">
                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUBLICADO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_red_social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTAGRAM"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
            <TextView
                android:id="@+id/tv_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ritual de mañana"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_editar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="Editar proyecto"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/background_color"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/text_primary"
                app:iconGravity="textStart"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>