<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER: Saludo y Notificaciones -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARTES, 14 DE MAYO"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola, Alex"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/circle_bg"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/text_primary"/>
    </RelativeLayout>

    <!-- HERO CARD: Expandida para llenar la pantalla -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_crear_proyecto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_gradient"
            android:padding="24dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Resplandor Amarillo -->
            <View
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:background="@drawable/bg_arrow_glow"
                app:layout_constraintTop_toTopOf="@id/card_arrow"
                app:layout_constraintBottom_toBottomOf="@id/card_arrow"
                app:layout_constraintStart_toStartOf="@id/card_arrow"
                app:layout_constraintEnd_toEndOf="@id/card_arrow" />

            <!-- Botón de Flecha Superior -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_arrow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#4DFFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- INICIO DE ELEMENTOS CENTRADOS -->
            <!-- Figura Verde Gigante (Cámara) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_camera_center"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardBackgroundColor="@color/accent_lime"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_hero_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera_outline"
                    app:tint="#1C1C1C" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Título Principal -->
            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crea algo\nincreíble"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/card_camera_center"
                app:layout_constraintBottom_toTopOf="@id/tv_hero_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tv_hero_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Toma una foto. Nosotros\nhacemos el resto."
                android:textAlignment="center"
                android:textColor="#B3B3B3"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_hero_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <!-- FIN DE ELEMENTOS CENTRADOS -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>