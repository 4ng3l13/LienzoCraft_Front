<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D0D0D0"
        android:layout_marginBottom="16dp"/>

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDITAR PROYECTO"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajusta tu contenido"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_primary"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image preview -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <View
                        android:id="@+id/img_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#C1C8A3"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cambiar_fondo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="12dp"
                    android:text="Cambiar fondo"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconTint="@color/text_primary"
                    app:iconSize="14dp"/>
            </RelativeLayout>

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE DEL PROYECTO"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_bg"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <!-- Texto de publicación -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEXTO DE LA PUBLICACIÓN"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_bg"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="top|start"
                android:minLines="3"/>

            <TextView
                android:id="@+id/tv_char_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="64/220"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Plataformas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLATAFORMAS"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:id="@+id/ll_plataformas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BORRADOR ACTIONS -->
                <LinearLayout
                    android:id="@+id/ll_actions_borrador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_ahora_borrador"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Publicar ahora"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent_lime"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_programar_borrador"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Programar"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/text_primary"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            app:icon="@android:drawable/ic_menu_my_calendar"
                            app:iconTint="@color/white"
                            app:iconGravity="textStart"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_eliminar_borrador"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Eliminar boceto"
                            android:textColor="#D32F2F"
                            app:backgroundTint="#FDECEE"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            app:icon="@android:drawable/ic_menu_delete"
                            app:iconTint="#D32F2F"
                            app:iconGravity="textStart"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- PROGRAMADO ACTIONS -->
                <LinearLayout
                    android:id="@+id/ll_actions_programado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_ahora_prog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Publicar ahora"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent_lime"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_editar_fecha_prog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Editar fecha y hora"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/text_primary"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_my_calendar"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_volver_borrador_prog"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Volver a borrador"
                        android:textColor="#D32F2F"
                        app:backgroundTint="#FDECEE"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_revert"
                        app:iconTint="#D32F2F"
                        app:iconGravity="textStart"/>
                </LinearLayout>

                <!-- PUBLICADO ACTIONS -->
                <LinearLayout
                    android:id="@+id/ll_actions_publicado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_guardar_publicado"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Guardar cambios"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/text_primary"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_save"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_eliminar_publicacion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Eliminar publicaciones"
                        android:textColor="#D32F2F"
                        app:backgroundTint="#FDECEE"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconTint="#D32F2F"
                        app:iconGravity="textStart"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>