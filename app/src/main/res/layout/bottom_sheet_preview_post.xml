<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D0D0D0"
        android:layout_marginBottom="16dp"/>

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VISTA PREVIA"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revisa tus publicaciones"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_preview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_primary"/>
    </RelativeLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:id="@+id/ll_previews_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Actions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_publicar_ahora_preview"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Publicar ahora"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/accent_lime"
        app:cornerRadius="16dp"
        app:elevation="0dp"
        app:icon="@android:drawable/ic_menu_send"
        app:iconTint="@color/text_primary"
        app:iconGravity="textStart"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_guardar_borrador_preview"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Guardar como borrador"
        android:textColor="@color/white"
        app:backgroundTint="@color/text_primary"
        app:cornerRadius="16dp"
        app:elevation="0dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconTint="@color/white"
        app:iconGravity="textStart"/>

</LinearLayout>